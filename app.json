{
  "expo": {
    "name": "Lumi-AI",
    "slug": "Lumi-IA",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/lumi-icon.png",
    "scheme": "lumiai",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/lumi-icon.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0F1220",
        "foregroundImage": "./assets/images/lumi-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ],
      "package": "com.andrew88sh.LumiIA"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/lumi-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/lumi-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-sqlite",
      "expo-audio",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "aa417267-45a2-428b-a4f2-8d41eec8920c"
      }
    }
  }
}
